# ─────────────────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# ─────────────────────────────────────────────────────────
# Base de datos MySQL
# ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=admisiones_fwd

# ─────────────────────────────────────────────────────────
# JWT (generar uno fuerte para producción)
# ─────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ─────────────────────────────────────────────────────────
# Admin inicial (usado por el seeder)
# ─────────────────────────────────────────────────────────
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────
# Email — Gmail SMTP con App Password
# ─────────────────────────────────────────────────────────
# Driver: 'stub' (solo loguea) | 'gmail' (envía vía Gmail SMTP)
MAIL_DRIVER=stub
MAIL_FROM="Admisiones FWD <admisiones@fwdcostarica.com>"

# App Password de Gmail (16 chars, sin espacios).
# Obtener en: https://myaccount.google.com/apppasswords  (requiere 2FA activado)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ─────────────────────────────────────────────────────────
# Google Calendar (OAuth 2.0)
# ─────────────────────────────────────────────────────────
# Credenciales de Google Cloud Console → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_REFRESH_TOKEN=

# 'primary' = calendario principal de la cuenta autorizada.
GOOGLE_CALENDAR_ID=primary

# Email de la psicóloga (agregada como invitada en cada entrevista).
PSICOLOGA_EMAIL=
PSICOLOGA_NOMBRE=

# Zona horaria de los eventos
EVENTOS_TIMEZONE=America/Costa_Rica
